{
  "$schema": "./dsdschema.json",
  "Name": "Bloom Pass Upsample",

  "DefaultPass": "Forward",

  "Resources": [
    {
      "Name": "INPUT_TEXTURE",
      "Kind": "SampledTexture",
      "Type": "Texture2D"
    }
  ],

  "Passes": [
    {
      "Name": "Forward",
      "MaterialBuffer": "Material",
      "Shaders": {
        "VS": "../Shaders/fullscreen.vert.hlsl",
        "FS": "../Shaders/bloom_upsample.frag.hlsl"
      },
      "States": {
        "Blend": "Additive",
        "Cull": "None",
        "Depth": "LessEqual"
      }
    }
  ]
}