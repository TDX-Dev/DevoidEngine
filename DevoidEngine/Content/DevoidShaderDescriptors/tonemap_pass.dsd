{
  "$schema": "./dsdschema.json",
  "Name": "Tonemap Shader",
  "DefaultPass": "Forward",

  "MaterialParameters": {"BufferName": "Material"},

  "Resources": [
    {
      "Name": "MAT_SceneColor",
      "Type": "Texture2D",
      "Kind": "SampledTexture"
    }
  ],

  "Passes": [
    {
      "Name": "Forward",
      "MaterialBuffer": "Material",
      "Shaders": {
        "VS": "../Shaders/fullscreen.vert.hlsl",
        "FS": "../Shaders/tonemap.frag.hlsl"
      },
      "States": {
        "Blend": "Alpha",
        "Cull": "None",
        "Depth": "LessEqual"
      }
    }
  ]
}