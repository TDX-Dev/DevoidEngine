{
  "$schema": "./dsdschema.json",
  "Name": "UI SDF TEXT Shader",
  "DefaultPass": "Forward",

  "MaterialParameters": {
    "BufferName": "Material"
  },
  "Resources": [
    {
      "Name": "MAT_Texture",
      "Type": "Texture2D",
      "Kind": "SampledTexture"
    }
  ],

  "Passes": [
    {
      "Name": "Forward",
      "MaterialBuffer": "Material",
      "Shaders": {
        "VS": "../Shaders/ui_textsdf.vert.hlsl",
        "FS": "../Shaders/ui_textsdf.frag.hlsl"
      },
      "States": {
        "Blend": "Alpha",
        "Cull": "Back",
        "Depth": "LessEqual"
      }
    }
  ]
}