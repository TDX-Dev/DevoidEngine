{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",

  "properties": {
    "Name": {
      "type": "string",
      "description": "Name of the shader"
    },

    "DefaultPass": {
      "type": "string",
      "description": "Name of the pass that materials will use by default."
    },

    "MaterialParameters": {
      "type": "object",
      "properties": {
        "BufferName": {
          "type": "string",
          "description": "Material buffer name"
        },

        "Textures": {
          "type": "array",
          "description": "Textures exposed to materials",
          "items": {
            "type": "object",
            "properties": {
              "Name": {
                "type": "string",
                "description": "Shader texture name"
              },

              "DisplayName": {
                "type": "string",
                "description": "Editor display name"
              },

              "Type": {
                "type": "string",
                "enum": [
                  "Texture2D",
                  "TextureCube",
                  "Texture2DArray"
                ]
              },

              "Default": {
                "type": "string",
                "description": "Default texture asset path"
              }
            },
            "required": [
              "Name",
              "Type"
            ]
          }
        }
      },

      "required": [
        "BufferName"
      ]
    },

    "Passes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string",
            "description": "Pass name (Forward, Shadow, etc)"
          },

          "Shaders": {
            "type": "object",
            "properties": {
              "VS": {
                "type": "string",
                "description": "Vertex shader path"
              },
              "FS": {
                "type": "string",
                "description": "Fragment shader path"
              }
            },
            "required": [ "VS", "FS" ]
          },

          "States": {
            "type": "object",
            "properties": {
              "Blend": {
                "type": "string",
                "enum": [ "Off", "Alpha", "Additive" ]
              },
              "Depth": {
                "type": "string",
                "enum": [ "Less", "LessEqual", "Always", "Disabled" ]
              },
              "Cull": {
                "type": "string",
                "enum": [ "Back", "Front", "None" ]
              }
            }
          }
        },
        "required": [ "Name", "Shaders" ]
      }
    }
  },

  "required": ["Passes", "DefaultPass", "Name"]
}