		<None Update="Lib\SharpFont.dll">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>


	<ItemGroup>
	  <None Update="Content\Shaders\ui.frag.hlsl">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <Visible>true</Visible>
	  </None>
	  <None Update="Content\Shaders\ui.vert.hlsl">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <Visible>true</Visible>
	  </None>
	  <None Update="Content\Shaders\sky_procedural.frag.hlsl">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <Visible>true</Visible>
	  </None>
	  <None Update="Content\Shaders\sky.vert.hlsl">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <Visible>true</Visible>
	  </None>
	</ItemGroup>


	<ItemGroup>
	  <Folder Include="Lib\" />
	</ItemGroup>

</Project>
